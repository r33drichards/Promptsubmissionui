# Environment variables for Docker Compose
# Copy this file to .env and fill in your values

# GitHub Personal Access Token
# Required for backend git operations
# Scopes needed: repo, user:email
GITHUB_TOKEN=your_github_personal_access_token_here

# Anthropic API Key
# Required for AI-powered features
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Railway API (only needed if using Railway deployment features)
# RAILWAY_API_KEY=your_railway_api_key_here
# RAILWAY_DEPLOYMENT_ID=your_deployment_id_here
